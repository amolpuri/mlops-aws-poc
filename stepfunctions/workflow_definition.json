{
  "Comment": "MLOps pipeline — triggers a SageMaker Processing Job via Step Functions",
  "StartAt": "RunSageMakerProcessingJob",
  "States": {
    "RunSageMakerProcessingJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync:2",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('mlops-job-{}', $$.Execution.Name)",
        "AppSpecification": {
          "ImageUri": "<YOUR_ECR_IMAGE_URI>",
          "ContainerEntrypoint": ["python3", "/opt/ml/processing/preprocess.py"]
        },
        "ProcessingInputs": [
          {
            "InputName": "input-data",
            "S3Input": {
              "S3Uri.$": "$.input_s3_uri",
              "LocalPath": "/opt/ml/processing/input",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "output-data",
              "S3Output": {
                "S3Uri": "s3://<YOUR_BUCKET>/output/",
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "RoleArn": "<YOUR_SAGEMAKER_EXECUTION_ROLE_ARN>"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "JobFailed"
        }
      ],
      "Next": "JobSucceeded"
    },
    "JobSucceeded": {
      "Type": "Succeed"
    },
    "JobFailed": {
      "Type": "Fail",
      "Error": "SageMakerProcessingJobFailed",
      "Cause": "The SageMaker Processing Job encountered an error."
    }
  }
}
